rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /nicknames/{nickname}
    // Document ID: Unique nickname string (3-24 characters, [a-zA-Z0-9_])
    // Fields:
    //   - uid: string (required, immutable) - Firebase UID of the reserving user
    //   - nickname: string (optional, <= 24 chars) - Lowercase/sanitized nickname
    //   - claimedAt: string (optional, <= 64 chars) - Timestamp of reservation
    //   - email: string (optional, <= 256 chars) - User's associated email
    //   - avatarDataUrl: string (optional, <= 200,000 chars) - Avatar image URI/data
    //
    // Collection: /users/{userId}
    // Document ID: Firebase UID matching {userId}
    // Fields:
    //   - uid: string (optional, immutable) - UID matching document ID {userId}
    //   - displayName: string (optional, <= 150 chars) - Profile display name
    //   - nickname: string (optional, <= 32 chars) - Handle/nickname
    //   - email: string (optional, <= 256 chars) - Contact email
    //   - photoURL: string (optional, <= 200,000 chars) - Avatar URL
    //   - authProvider: string (optional, <= 50 chars) - Provider name
    //   - activeProjectId: string (optional, <= 128 chars) - Current project reference
    //   - projects: list (optional, <= 500 items) - Scoped user project objects
    //
    // Subcollections: /users/{userId}/{allSubcollections=**}
    // Access: Isolated strictly to the owning user (request.auth.uid == userId)
    //
    // Collection: /tracking/{userId}/activity/{eventId}
    // Document ID: Unique audit event ID
    // Fields:
    //   - eventId: string (required, <= 128 chars) - Event ID
    //   - userId: string (required, immutable) - UID matching {userId}
    //   - eventType: string (optional, <= 100 chars) - Activity classification
    //   - action: string (optional, <= 100 chars) - Action name
    //   - nickname: string (optional, <= 32 chars) - Nickname at event creation
    //   - metadata: map (optional) - Structured event metadata
    //   - timestamp: string (optional, <= 64 chars) - ISO timestamp
    //   - device: map (optional) - Platform/telemetry snapshot
    //
    // Extensible Feature Collections: /{featureCollection}/{docId}
    // Match: Any collection outside system reserved collections ['users', 'nicknames', 'tracking']
    // Fields:
    //   - ownerId: string (required on write) - Document owner's Firebase UID
    //
    // ===============================================================

    // ===============================================================
    // Standard Helper Functions
    // ===============================================================

    // Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the current user is the owner matching userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify uid field cannot be modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        (resource != null && request.resource.data.uid == resource.data.uid);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate Nickname Registry document schema & bounds
    function isValidNicknameDoc(nickname) {
      return nickname.matches('^[a-zA-Z0-9_]{3,24}$')
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 24))
        && (!('claimedAt' in request.resource.data) || (request.resource.data.claimedAt is string && request.resource.data.claimedAt.size() <= 64))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 256))
        && (!('avatarDataUrl' in request.resource.data) || (request.resource.data.avatarDataUrl is string && request.resource.data.avatarDataUrl.size() <= 200000));
    }

    // Validate User Profile document schema & bounds
    function isValidUserDoc(userId) {
      return (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid == userId))
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 150))
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 32))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 256))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 200000))
        && (!('authProvider' in request.resource.data) || (request.resource.data.authProvider is string && request.resource.data.authProvider.size() <= 50))
        && (!('projects' in request.resource.data) || (request.resource.data.projects is list && request.resource.data.projects.size() <= 500));
    }

    // Validate Activity Telemetry record schema & bounds
    function isValidActivityEvent(userId) {
      return request.resource.data.userId is string
        && request.resource.data.userId == userId
        && (!('eventType' in request.resource.data) || (request.resource.data.eventType is string && request.resource.data.eventType.size() <= 100))
        && (!('action' in request.resource.data) || (request.resource.data.action is string && request.resource.data.action.size() <= 100))
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 32))
        && (!('timestamp' in request.resource.data) || (request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 64))
        && (!('metadata' in request.resource.data) || request.resource.data.metadata is map)
        && (!('device' in request.resource.data) || request.resource.data.device is map);
    }

    // ===============================================================
    // 1. Global Default Deny Rule
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 2. Nicknames Registry (/nicknames/{nickname})
    // ===============================================================
    match /nicknames/{nickname} {
      // Unauthenticated or authenticated users can check single nickname availability
      allow get: if true;

      // Disallow collection-wide list to prevent bulk scraping
      allow list: if false;

      // Authenticated users can claim an available nickname matching character/length constraints
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && isValidNicknameDoc(nickname);

      // Only the reserving user can update their nickname mapping, maintaining uid immutability
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && uidNotModified()
        && isValidNicknameDoc(nickname);

      // Only the reserving user can delete/release their nickname
      allow delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // 3. User Profiles and Scoped Workspaces (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      // Authenticated users can read author profiles, nicknames, and avatars
      allow read: if isAuthenticated();

      // Only the authenticated owner can create their profile
      allow create: if isOwner(userId)
        && isValidUserDoc(userId);

      // Only the authenticated owner can update their profile with immutable UID protection
      allow update: if isOwner(userId)
        && uidNotModified()
        && isValidUserDoc(userId);

      // Only the authenticated owner can delete their profile
      allow delete: if isOwner(userId);

      // Subcollections under /users/{userId}/... (projects, settings, drafts)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // 4. Activity Tracking & Audit Telemetry (/tracking/{userId}/activity/{eventId})
    // ===============================================================
    match /tracking/{userId}/activity/{eventId} {
      // Append-only audit log: owner can read their activity history
      allow read: if isOwner(userId);

      // Owner can append audit logs tagged with their own userId
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && isValidActivityEvent(userId);

      // Immutability protection: audit events cannot be modified or deleted
      allow update, delete: if false;
    }

    // ===============================================================
    // 5. Extensible Feature Collections (Future Plug-and-Play Features)
    // ===============================================================
    match /{featureCollection}/{docId} {
      allow read, write: if isAuthenticated()
        && !(featureCollection in ['users', 'nicknames', 'tracking', 'app_meta'])
        && (resource == null || resource.data.ownerId == request.auth.uid)
        && (request.resource == null || request.resource.data.ownerId == request.auth.uid);
    }

    // ===============================================================
    // 6. Application Metadata & Desktop Auto-Updater Trigger
    // ===============================================================
    match /app_meta/{metaDoc} {
      // Desktop clients can listen in real-time to release broadcasts
      allow read: if true;
      // Writes reserved strictly for Firebase Admin SDK via CI/CD
      allow write: if false;
    }
  }
}
