{
  "name": "y-master-editor",
  "productName": "Y Master Editor",
  "version": "3.0.5",
  "description": "Y Master Editor — Precision Vector PDF & Presentation Studio with MCP Agent Integration",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server.cjs",
    "mcp": "node electron/mcp-server.cjs",
    "mcp:http": "node electron/web-mcp-gateway.cjs",
    "test": "node test/engine-test.cjs && node test/pdf-adapter-test.cjs && node test/e2e-mcp-integration-test.cjs && node test/import-pipeline-test.cjs && node test/omni-auth-telemetry-test.cjs && node test/claude-mcp-connector-test.cjs",
    "build:icon": "powershell -ExecutionPolicy Bypass -File scripts/create-icon.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:all": "electron-builder"
  },
  "keywords": [
    "pdf",
    "editor",
    "mcp",
    "electron",
    "presentation",
    "pptx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "firebase": "^12.19.0",
    "konva": "^10.7.1",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "firebase-admin": "^14.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yorren005/Y-Master-Editor.git"
  },
  "build": {
    "appId": "com.independent.desktopapp",
    "productName": "Y Master Editor",
    "publish": [
      {
        "provider": "github",
        "owner": "yorren005",
        "repo": "Y-Master-Editor",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "firebase-config.json",
      "firestore.rules",
      "document_state.json",
      "user_accounts.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Y Master Editor"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
