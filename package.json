{
  "name": "y-master-editor",
  "productName": "Y Master Editor",
  "version": "2.0.0",
  "description": "Y Master Editor — Precision Vector PDF & Presentation Studio with MCP Agent Integration",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server.cjs",
    "mcp": "node electron/mcp-server.cjs",
    "build:icon": "powershell -ExecutionPolicy Bypass -File scripts/create-icon.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:all": "electron-builder"
  },
  "keywords": [
    "pdf",
    "editor",
    "mcp",
    "electron",
    "presentation",
    "pptx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "firebase": "^12.19.0",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ymastereditor.app",
    "productName": "Y Master Editor",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Y Master Editor",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
